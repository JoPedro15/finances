<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Portfolio Opportunity Report — {{ generated_at }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0d1117; color: #c9d1d9;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      font-size: 13px; line-height: 1.6; padding: 32px;
    }
    .page { max-width: 1000px; margin: 0 auto; }
    .report-header { border-bottom: 1px solid #30363d; padding-bottom: 18px; margin-bottom: 28px; }
    .report-header h1 { font-size: 24px; font-weight: 700; color: #58a6ff; }
    .report-meta { margin-top: 5px; color: #8b949e; font-size: 12px; }
    h2 { font-size: 15px; font-weight: 600; color: #e6edf3; border-left: 3px solid #58a6ff;
         padding-left: 10px; margin-bottom: 14px; margin-top: 28px; }
    h3 { font-size: 13px; font-weight: 600; color: #e6edf3; margin-bottom: 10px; margin-top: 20px; }

    /* Summary cards */
    .summary-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-bottom: 8px; }
    .summary-card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 14px 18px; }
    .card-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #8b949e; margin-bottom: 5px; }
    .card-value { font-size: 20px; font-weight: 700; color: #e6edf3; }

    /* Strategy weights */
    .weights-box { background: #161b22; border: 1px solid #30363d; border-radius: 8px;
                   padding: 14px 18px; margin-bottom: 8px; font-size: 12px; }
    .weights-box .wrow { display: flex; gap: 32px; flex-wrap: wrap; margin-top: 6px; }
    .weights-box .witem { color: #8b949e; }
    .weights-box .witem span { color: #c9d1d9; font-weight: 600; }

    /* Tables */
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    thead tr { background: #161b22; }
    th { text-align: left; padding: 9px 11px; font-size: 10px; text-transform: uppercase;
         letter-spacing: 0.5px; color: #8b949e; border-bottom: 1px solid #30363d; }
    th.right, td.right { text-align: right; }
    th.center, td.center { text-align: center; }
    tbody tr { border-bottom: 1px solid #21262d; }
    tbody tr:last-child { border-bottom: none; }
    td { padding: 9px 11px; color: #c9d1d9; }

    .tag { display: inline-block; padding: 1px 6px; border-radius: 4px;
           font-size: 10px; font-weight: 600; text-transform: uppercase; }
    .tag-stock { background: #1f3a5f; color: #58a6ff; }
    .tag-etf   { background: #1f3a3a; color: #39d353; }

    .action-buy  { color: #3fb950; font-weight: 700; }
    .action-sell { color: #f85149; font-weight: 700; }
    .action-hold { color: #d29922; font-weight: 700; }
    .action-na   { color: #8b949e; }

    .urg-high   { color: #f85149; font-weight: 600; }
    .urg-medium { color: #d29922; font-weight: 600; }
    .urg-low    { color: #3fb950; font-weight: 600; }

    /* Advisory cards */
    .advisory-card { background: #161b22; border: 1px solid #30363d; border-radius: 8px;
                     padding: 16px 20px; margin-bottom: 12px; }
    .advisory-card.buy  { border-left: 3px solid #3fb950; }
    .advisory-card.sell { border-left: 3px solid #f85149; }
    .advisory-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
    .advisory-symbol { font-size: 16px; font-weight: 700; color: #e6edf3; }
    .advisory-meta { font-size: 11px; color: #8b949e; }
    .advisory-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px; }
    .advisory-section-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px;
                               color: #8b949e; margin-bottom: 6px; }
    .advisory-row { display: flex; justify-content: space-between; font-size: 12px;
                    padding: 3px 0; border-bottom: 1px solid #21262d; }
    .advisory-row:last-child { border-bottom: none; }
    .advisory-key { color: #8b949e; }
    .advisory-val { color: #c9d1d9; font-weight: 500; }
    .reasoning { font-size: 12px; color: #8b949e; font-style: italic; margin-top: 10px;
                 padding-top: 10px; border-top: 1px solid #21262d; }

    .score-bar-bg { background: #21262d; border-radius: 3px; height: 6px; width: 80px; display: inline-block; vertical-align: middle; }
    .score-bar-fill { background: #58a6ff; border-radius: 3px; height: 6px; display: block; }

    .report-footer { margin-top: 40px; padding-top: 14px; border-top: 1px solid #30363d;
                     font-size: 11px; color: #8b949e; text-align: center; }

    @page { size: A4; margin: 14mm 12mm; }
    @media print {
      body { background: #0d1117; color: #c9d1d9; padding: 0; }
      .summary-row { display: block; }
      .summary-card { display: inline-block; width: 31%; vertical-align: top; margin-right: 2%; margin-bottom: 8px; }
      .advisory-grid { display: block; }
      .advisory-grid > div { margin-bottom: 8px; }
      h2 { page-break-after: avoid; }
      .advisory-card { page-break-inside: avoid; }
      tbody tr { page-break-inside: avoid; }
    }
  </style>
</head>
<body>
<div class="page">

  <div class="report-header">
    <h1>Portfolio Opportunity &amp; Rebalancing Report</h1>
    <div class="report-meta">Generated: {{ generated_at }}</div>
  </div>

  <!-- Summary -->
  <h2>Portfolio &amp; Strategy Summary</h2>
  <div class="summary-row">
    <div class="summary-card">
      <div class="card-label">Total Portfolio Value</div>
      <div class="card-value">€{{ "{:,.2f}".format(total_value_eur) }}</div>
    </div>
    <div class="summary-card">
      <div class="card-label">Assets Evaluated</div>
      <div class="card-value">{{ assets|length }}</div>
    </div>
    <div class="summary-card">
      <div class="card-label">AI Analysis</div>
      <div class="card-value" style="font-size:15px;">{{ "Active" if has_ai else "Quant Only" }}</div>
    </div>
  </div>

  <div class="weights-box">
    <div style="color:#e6edf3; font-weight:600; margin-bottom:4px;">Active Strategy Weights</div>
    <div class="wrow">
      <div class="witem">Stocks — Dip: <span>{{ "%.2f"|format(w_stock_dip) }}</span> | Fwd P/E: <span>{{ "%.2f"|format(w_stock_pe) }}</span> | 52w: <span>{{ "%.2f"|format(w_stock_52w) }}</span> | Gap: <span>{{ "%.2f"|format(w_stock_gap) }}</span></div>
      <div class="witem">ETFs — Dip: <span>{{ "%.2f"|format(w_etf_dip) }}</span> | TER: <span>{{ "%.2f"|format(w_etf_ter) }}</span> | Gap: <span>{{ "%.2f"|format(w_etf_gap) }}</span></div>
      <div class="witem">Penalties — Sector: <span>{{ "%.2f"|format(w_sector_pen) }}</span> | Country: <span>{{ "%.2f"|format(w_country_pen) }}</span></div>
    </div>
  </div>

  <!-- Opportunity Matrix -->
  <h2>Rebalancing &amp; Opportunity Matrix</h2>
  <table>
    <thead>
      <tr>
        <th class="center">Rank</th>
        <th>Symbol</th>
        <th>Type</th>
        <th class="right">Price (€)</th>
        <th class="right">Current %</th>
        <th class="right">Target %</th>
        <th class="right">Score</th>
        {% if has_ai %}<th class="center">Action</th><th class="center">Urgency</th><th class="right">Conf.</th>{% endif %}
      </tr>
    </thead>
    <tbody>
      {% for a in assets %}
      <tr>
        <td class="center" style="color:#d29922;">{{ a.rank }}</td>
        <td><strong>{{ a.symbol }}</strong></td>
        <td><span class="tag {{ 'tag-etf' if a.asset_type == 'ETF' else 'tag-stock' }}">{{ a.asset_type }}</span></td>
        <td class="right">{{ "{:,.2f}".format(a.price_eur) }}</td>
        <td class="right">{{ "%.1f"|format(a.current_pct) }}%</td>
        <td class="right">{{ "%.1f"|format(a.target_pct) }}%</td>
        <td class="right" style="color:#58a6ff; font-weight:600;">{{ "%.3f"|format(a.score) }}</td>
        {% if has_ai %}
        <td class="center"><span class="action-{{ a.ai_action|lower if a.ai_action else 'na' }}">{{ a.ai_action or "N/A" }}</span></td>
        <td class="center"><span class="urg-{{ a.ai_urgency|lower if a.ai_urgency else 'na' }}">{{ a.ai_urgency or "N/A" }}</span></td>
        <td class="right">{{ a.ai_conf or "N/A" }}</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <!-- Advisory Insights -->
  {% if has_ai and advisories %}
  <h2>Actionable Advisory Insights</h2>
  {% for adv in advisories %}
  <div class="advisory-card {{ adv.action|lower }}">
    <div class="advisory-header">
      <div class="advisory-symbol">{{ adv.symbol }}</div>
      <span class="tag {{ 'tag-etf' if adv.asset_type == 'ETF' else 'tag-stock' }}">{{ adv.asset_type }}</span>
      <span class="action-{{ adv.action|lower }}" style="font-size:14px;">{{ adv.action }}</span>
      <span class="urg-{{ adv.urgency|lower }}">{{ adv.urgency }}</span>
      <span style="color:#8b949e;">{{ adv.confidence }}</span>
    </div>
    <div class="advisory-meta">
      Price: <strong style="color:#e6edf3;">€{{ "{:,.2f}".format(adv.price) }}</strong>
      &nbsp;|&nbsp; 52w Peak: €{{ "{:,.2f}".format(adv.peak) }}
      &nbsp;|&nbsp; Gap: Current {{ "%.1f"|format(adv.curr_alloc) }}% → Target {{ "%.1f"|format(adv.targ_alloc) }}%
      &nbsp;(<span class="{{ 'action-buy' if adv.delta >= 0 else 'action-sell' }}">{{ "%+.1f"|format(adv.delta) }}%</span>)
    </div>

    {% if adv.asset_type == 'ETF' %}
    <div class="advisory-grid">
      <div>
        <div class="advisory-section-title">ETF Metrics</div>
        <div class="advisory-row"><span class="advisory-key">TER</span><span class="advisory-val">{{ adv.ter_str }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Top Holdings</span><span class="advisory-val" style="font-size:11px;">{{ adv.holdings_str }}</span></div>
      </div>
      <div>
        <div class="advisory-section-title">Exposure</div>
        <div class="advisory-row"><span class="advisory-key">Sectors</span><span class="advisory-val" style="font-size:11px;">{{ adv.sectors_str }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Countries</span><span class="advisory-val" style="font-size:11px;">{{ adv.countries_str }}</span></div>
      </div>
    </div>
    {% else %}
    <div class="advisory-grid">
      <div>
        <div class="advisory-section-title">Valuation</div>
        <div class="advisory-row"><span class="advisory-key">Trailing P/E</span><span class="advisory-val">{{ adv.tr_pe }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Forward P/E</span><span class="advisory-val">{{ adv.fwd_pe }}</span></div>
        <div class="advisory-row"><span class="advisory-key">PEG Ratio</span><span class="advisory-val">{{ adv.peg }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Price/Book</span><span class="advisory-val">{{ adv.pb }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Div Yield</span><span class="advisory-val">{{ adv.div_yield }}</span></div>
      </div>
      <div>
        <div class="advisory-section-title">Fundamentals</div>
        <div class="advisory-row"><span class="advisory-key">Beta</span><span class="advisory-val">{{ adv.beta }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Profit Margin</span><span class="advisory-val">{{ adv.margin }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Rev Growth</span><span class="advisory-val">{{ adv.rev_growth }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Earn Growth</span><span class="advisory-val">{{ adv.earn_growth }}</span></div>
        <div class="advisory-row"><span class="advisory-key">Debt/Equity</span><span class="advisory-val">{{ adv.debt_eq }}</span></div>
      </div>
    </div>
    {% endif %}

    <div>
      <div class="advisory-section-title" style="margin-top:10px;">Factor Scores</div>
      <div style="display:flex; gap:20px; flex-wrap:wrap; font-size:12px;">
        <div>Dip <strong style="color:#58a6ff;">{{ "%.2f"|format(adv.dip_score) }}</strong></div>
        <div>Cost <strong style="color:#58a6ff;">{{ "%.2f"|format(adv.cost_score) }}</strong></div>
        <div>Gap <strong style="color:#58a6ff;">{{ "%.2f"|format(adv.gap_score) }}</strong></div>
        <div>Total <strong style="color:#e6edf3;">{{ "%.3f"|format(adv.total_score) }}</strong></div>
      </div>
    </div>

    <div class="reasoning">{{ adv.reasoning }}</div>
  </div>
  {% endfor %}
  {% endif %}

  <div class="report-footer">
    Generated by finances portfolio tracker &nbsp;|&nbsp; For personal use only. Not financial advice.
  </div>
</div>
</body>
</html>
